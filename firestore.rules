// =============================================================================
// Axelrod — Firestore Security Rules
//
// Rules language version: '2' (Firestore current). Tracking of OUR rule
// changes lives below + in README.md → "Schema changes".
//
// Changelog (most recent first) :
//   2026-05-15  Duels : top-level /duels collection for free-form 1v1
//               practice matches between teams. Read by inviter, invitee
//               and admin; create by inviter; update by invitee (accept /
//               decline) and by either side to write the result.
//   2026-05-11  Admin-run tournament : admins can now write
//               /tournaments/{tid}/matches/* and /leaderboards/* (since the
//               match runner lives in the admin browser via Pyodide, not in
//               Cloud Functions). Reads remain open to all signed-in users.
//   2026-05-11  Collection group query support : add recursive
//               `match /{path=**}/teams/{teamId}` to authorize the
//               collection group query used by team-context.js.
//   2026-05-11  Multi-tournament : drop active_tournament_id on /teams,
//               admin-only create on /tournaments/{tid}/teams/{teamId},
//               teams discoverable via collection group `team_id` query.
//   2026-05-10  Bot model refactor : drop /bots subcollection, bot stored
//               as fields on /tournaments/{tid}/teams/{teamId}.
//   2026-05-09  Schema rework : /teams promoted to top-level, /users
//               mapping dropped, /strategies added under team.
//   2026-05-08  Sprint Strategies : added /strategies subcollection,
//               separate strategy lifecycle from bot submissions.
//   2026-05-07  Initial release : /admins, /tournaments + nested teams/bots.
//
// Deploy : firebase deploy --only firestore
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Collection group query support. Une collection group query sur "teams"
    // (top-level /teams + sous-collection /tournaments/{tid}/teams) exige une
    // règle avec wildcard récursif {path=**} en plus des règles spécifiques.
    // Sans ça, le client reçoit "Missing or insufficient permissions" alors
    // même que la lecture directe doc-par-doc serait autorisée.
    match /{path=**}/teams/{teamId} {
      allow read: if isSignedIn();
    }

    // Liste des UIDs admin. Lecture pour tout utilisateur signé (chaque page
    // vérifie si elle-même est admin), écriture impossible depuis le client
    // (gérée à la main dans la console Firebase).
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Équipes — top-level. Le doc ID est l'UID Firebase Auth du compte
    // partagé par les 2 élèves de l'équipe. Une équipe persiste à travers
    // les tournois. Les inscriptions aux tournois sont matérialisées par
    // les docs `/tournaments/{tid}/teams/{uid}` (multi-tournoi possible).
    match /teams/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      // Bibliothèque de stratégies — privée à l'équipe propriétaire en
      // écriture, mais lisible par les admins (pour les compteurs côté
      // panneau admin) et par l'équipe elle-même.
      match /strategies/{strategyId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow create, update, delete: if isSignedIn() && request.auth.uid == uid;
      }

      // Historique des soumissions de l'équipe — append-only. Chaque submit
      // y ajoute un snapshot (tournoi, stratégie, code, statut). Jamais
      // supprimé pour préserver la trace pédagogique.
      match /submissions/{submissionId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      // Participation d'une équipe à ce tournoi. Le doc ID est l'UID de
      // l'équipe (égal à son UID Firebase Auth).
      // - Admin : créer / supprimer (= inscrire / désinscrire l'équipe au tournoi)
      // - Équipe propriétaire : peut mettre à jour son propre doc (= soumettre son bot).
      //   La contrainte 1-shot est gérée côté UI.
      // Le champ team_id est dénormalisé pour permettre une collection group
      // query côté équipe ("dans quels tournois suis-je inscrite ?").
      match /teams/{teamId} {
        allow read: if isSignedIn();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() ||
                         (isSignedIn() && request.auth.uid == teamId);
      }

      // Matches et leaderboards écrits par l'admin depuis le runner Pyodide
      // (côté page admin). Lecture ouverte à toute équipe signée.
      match /matches/{matchId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      match /leaderboards/{phaseId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // Duels — practice 1v1 between two teams. Schema:
    //   inviter_uid, invitee_uid, inviter_strategy_*, invitee_strategy_*,
    //   nb_turns, noise_level, status, created_at, responded_at,
    //   completed_at, result.
    //
    // Read: both participants + admin.
    // Create: signed in, only as the inviter, only as a fresh pending duel.
    // Update: both participants (invitee accepts/declines; either side may
    //   write the result/error once the match has run). Admin too.
    // Delete: admin only (audit trail).
    match /duels/{duelId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.inviter_uid ||
        request.auth.uid == resource.data.invitee_uid
      );
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.inviter_uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.invitee_uid is string &&
        request.resource.data.invitee_uid != request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.inviter_uid ||
        request.auth.uid == resource.data.invitee_uid
      );
      allow delete: if isAdmin();
    }
  }
}
